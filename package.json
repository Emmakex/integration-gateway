{
  "name": "integration-gateway",
  "version": "0.5.0",
  "private": true,
  "description": "Reusable backend starter for REST APIs, signed webhooks, SOAP/XML, background jobs and enterprise integrations.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:safety": "node scripts/public-safety-check.mjs",
    "check": "npm run check:safety && npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "fastify": "5.10.0",
    "fastify-raw-body": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
