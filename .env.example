SERVICE_NAME=Integration Gateway
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Leave empty to disable signed webhook ingestion.
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_AGE_SECONDS=300

# Demo/read-only audit endpoint. Keep false in production unless separately protected.
EXPOSE_AUDIT_API=false

# Leave empty to disable outbound REST integrations.
OUTBOUND_BASE_URL=
OUTBOUND_TIMEOUT_MS=3000
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_BASE_DELAY_MS=250
OUTBOUND_RETRY_MAX_DELAY_MS=2000

# Leave empty to disable outbound SOAP integrations.
SOAP_ENDPOINT=
SOAP_TIMEOUT_MS=5000
SOAP_MAX_RESPONSE_BYTES=1048576

# Fictional demo routes. Keep false in production.
ENABLE_DEMO_API=false
ENABLE_DEMO_TARGET=false
